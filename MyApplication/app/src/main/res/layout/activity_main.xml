<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!--
        상단 기능 토글 바.
        아이콘 버튼 대신 SwitchCompat 토글 스위치를 사용하여 더 작은 공간에서
        ON/OFF 상태를 명확하게 표시한다.

        좌측: 객체 감지 (switchObjectMode) — 기본 ON
        구분선
        우측: 카테고리 분류 (switchLandscapeMode) — 기본 OFF

        두 토글은 독립적이며 동시 활성화를 지원한다.
    -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="28dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 객체 감지 토글 그룹: 라벨 + 스위치 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="객체 감지"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:layout_marginEnd="6dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchObjectMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <!--
            구분선: 두 토글 그룹 사이를 시각적으로 분리한다.
            alpha=0.3으로 배경보다 부드럽게 처리하여 강조를 줄인다.
        -->
        <View
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="#FFFFFF"
            android:alpha="0.3" />

        <!-- 카테고리 분류 토글 그룹: 라벨 + 스위치 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="카테고리 분류"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:layout_marginEnd="6dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchLandscapeMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false" />
        </LinearLayout>
    </LinearLayout>

    <!-- 카메라 프리뷰 -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="3:4"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:scaleType="fitCenter" />

    <!--
        풍경 모드 구도 추론 결과 — viewFinder 우상단에 오버레이
        구도 이름 + 0~100 점수를 표시한다.
        풍경 모드에서만 VISIBLE, 그 외엔 GONE.
    -->
    <LinearLayout
        android:id="@+id/landscapeScoreLayout"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/score_background"
        android:elevation="10dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/viewFinder"
        app:layout_constraintTop_toTopOf="@id/viewFinder">

        <!-- 현재 구도 이름 -->
        <TextView
            android:id="@+id/tvCompositionName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <!-- 분류 상태 표시 (불안정 / 안정 / 최적) -->
        <TextView
            android:id="@+id/tvLandscapeScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- 바운딩 박스 오버레이 — viewFinder 와 동일 영역 -->
    <com.example.myapplication.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        app:layout_constraintTop_toTopOf="@id/viewFinder"
        app:layout_constraintBottom_toBottomOf="@id/viewFinder"
        app:layout_constraintStart_toStartOf="@id/viewFinder"
        app:layout_constraintEnd_toEndOf="@id/viewFinder" />

    <!-- 구도 가이드 박스 오버레이 — viewFinder 와 동일 영역 -->
    <com.example.myapplication.GuideOverlayView
        android:id="@+id/guideOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:clickable="false"
        app:layout_constraintTop_toTopOf="@id/viewFinder"
        app:layout_constraintBottom_toBottomOf="@id/viewFinder"
        app:layout_constraintStart_toStartOf="@id/viewFinder"
        app:layout_constraintEnd_toEndOf="@id/viewFinder" />

    <!--
        수준기 인디케이터 — viewFinder 하단 중앙에 오버레이.
        중력 센서에서 계산된 roll 각도를 실시간으로 표시한다.
        색상(초록·노랑·빨강)으로 수평 여부를 직관적으로 나타낸다.
        elevation으로 다른 오버레이보다 위에 표시한다.
    -->
    <com.example.myapplication.LevelIndicatorView
        android:id="@+id/levelIndicator"
        android:layout_width="120dp"
        android:layout_height="48dp"
        android:layout_marginBottom="14dp"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="@id/viewFinder"
        app:layout_constraintStart_toStartOf="@id/viewFinder"
        app:layout_constraintEnd_toEndOf="@id/viewFinder" />

    <!--
        갤러리 열기 버튼.
        viewFinder 아래 공간의 좌측에 배치하여 Android 네비게이션 바와 겹치지 않는다.
        셔터 버튼과 같은 행에 위치하도록 viewFinder 하단~화면 하단 사이를 수직 중앙 정렬한다.
    -->
    <ImageButton
        android:id="@+id/btnOpenGallery"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_gallery"
        android:scaleType="fitCenter"
        android:contentDescription="@string/desc_open_gallery"
        android:elevation="15dp"
        app:tint="@android:color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/viewFinder"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!--
        구도 선택 버튼 + 포커스 해제 버튼
        — viewFinder 상단 좌측에 오버레이 (하단 내비게이션 바와 겹치지 않음)
        — 피사체 선택 전에는 GONE, 선택 후 VISIBLE
        — elevation으로 모든 오버레이보다 위에 표시
    -->
    <LinearLayout
        android:id="@+id/compositionBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        android:elevation="15dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent">

        <!-- 구도 유형 선택 (팝업 메뉴) -->
        <Button
            android:id="@+id/btnComposition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_composition"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:backgroundTint="#FFE94560"
            android:layout_marginEnd="6dp" />

        <!-- 피사체 포커스 해제 -->
        <Button
            android:id="@+id/btnUnfocus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_unfocus"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:backgroundTint="#FF555555" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
